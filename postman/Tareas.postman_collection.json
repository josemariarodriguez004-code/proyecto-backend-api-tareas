              "pm.test('Código HTTP 204', () => pm.response.to.have.status(204));",
              "pm.test('Respuesta sin cuerpo', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 · Consultar la tarea eliminada",
      "request": {
        "method": "GET",
        "url": {
