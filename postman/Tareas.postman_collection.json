            ]
          }
        }
      ]
    },
    {
      "name": "14 · Actualizar la tarea eliminada",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Ya eliminada\"\n}"
        }
