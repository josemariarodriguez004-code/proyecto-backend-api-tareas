        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Error JSON descriptivo', () => pm.expect(pm.response.json().error).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 · Rechazar una fecha imposible",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Calendario\",\n  \"fechaLimite\": \"2026-02-30\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Error JSON descriptivo', () => pm.expect(pm.response.json().error).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 · Actualizar la tarea",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Exposición preparada\",\n  \"descripcion\": \"Diagrama y colección revisados\",\n  \"fechaLimite\": \"2026-12-10\",\n  \"estado\": \"completado\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('La tarea conserva el ID y todos los datos actualizados', () => {",
              "  pm.expect(pm.response.json()).to.deep.equal({id: Number(pm.collectionVariables.get('taskId')), titulo: 'Exposición preparada', descripcion: 'Diagrama y colección revisados', fechaLimite: '2026-12-10', estado: 'completado'});",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 · Rechazar un estado desconocido",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Otro título\",\n  \"estado\": \"cerrado\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Error JSON descriptivo', () => pm.expect(pm.response.json().error).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 · Comprobar que la actualización válida persiste",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('La tarea conserva el ID y todos los datos actualizados', () => {",
              "  pm.expect(pm.response.json()).to.deep.equal({id: Number(pm.collectionVariables.get('taskId')), titulo: 'Exposición preparada', descripcion: 'Diagrama y colección revisados', fechaLimite: '2026-12-10', estado: 'completado'});",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 · Rechazar un tipo de contenido incorrecto",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "texto"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 415', () => pm.response.to.have.status(415));",
