        }
      ]
    },
    {
      "name": "16 · Comprobar el listado final",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('El ID eliminado ya no aparece', () => {",
              "  pm.expect(pm.response.json().map(t => t.id)).not.to.include(Number(pm.collectionVariables.get('taskId')));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
