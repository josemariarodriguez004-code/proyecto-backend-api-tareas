{
  "info": {
    "name": "API de gestión de tareas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. La primera petición guarda el ID de la tarea y las últimas verifican su eliminación. Cambiar baseUrl para probar el despliegue."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 · Crear una tarea",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Preparar la exposición\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('taskId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('La tarea tiene ID y valores iniciales', () => {",
              "  const task = pm.response.json();",
              "  pm.expect(task.id).to.be.a('number').and.greaterThan(0);",
              "  pm.expect(task).to.deep.equal({id: task.id, titulo: 'Preparar la exposición', descripcion: '', fechaLimite: null, estado: 'pendiente'});",
              "  pm.expect(pm.response.headers.get('Location')).to.eql('/tasks/' + task.id);",
              "  pm.collectionVariables.set('taskId', String(task.id));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Listar y localizar la tarea creada",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('La lista contiene el ID creado', () => {",
              "  const tasks = pm.response.json();",
              "  pm.expect(tasks).to.be.an('array');",
              "  pm.expect(tasks.map(t => t.id)).to.include(Number(pm.collectionVariables.get('taskId')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Consultar por ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "{{taskId}}"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve la tarea solicitada', () => {",
              "  const task = pm.response.json();",
              "  pm.expect(task.id).to.eql(Number(pm.collectionVariables.get('taskId')));",
              "  pm.expect(task.titulo).to.eql('Preparar la exposición');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Rechazar un título vacío",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"  \"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Error JSON descriptivo', () => pm.expect(pm.response.json().error).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 · Rechazar un parámetro de listado no admitido",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks?filtro=inexistente",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ],
          "query": [
            {
              "key": "filtro",
              "value": "inexistente"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Error JSON descriptivo', () => pm.expect(pm.response.json().error).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · Rechazar un ID de texto",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks/abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "abc"
          ]
